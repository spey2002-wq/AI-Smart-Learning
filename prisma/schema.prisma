generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  fullName     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  savedNotes   SavedNote[]
  quizzes      Quiz[]
}

model SavedNote {
  id        String   @id @default(cuid())
  title     String
  content   String
  summary   String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Quiz {
  id        String   @id @default(cuid())
  topic     String
  score     Int
  questions Json
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
